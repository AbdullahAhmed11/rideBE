# Copy to .env and fill in values. Never commit .env.

PORT=4000
NODE_ENV=development

# MongoDB Atlas (include database name in path), e.g.
# mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/ride?retryWrites=true&w=majority
MONGODB_URI=

# Used to sign JWTs — use a long random string in production
JWT_SECRET=

# Comma-separated browser origins for CORS (Vite dashboard, Expo web, etc.)
CLIENT_ORIGINS=http://localhost:5173,http://localhost:8081

# Optional: public API origin for absolute image URLs in JSON (no trailing slash)
# API_PUBLIC_URL=http://localhost:4000
